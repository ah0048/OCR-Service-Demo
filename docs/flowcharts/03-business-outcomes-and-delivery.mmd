%% Business decisions are in the exact order of BusinessRules.Evaluate.
%% Completed is a lifecycle status, not a synonym for Succeeded.
flowchart TB
    subgraph LIFECYCLE["Persistent job lifecycle"]
        CREATED["API saves job<br/>Status Queued; outcome null"]
        STARTED["Started event successfully applied<br/>Status OcrInProgress"]
        FINISHED["Business result transaction commits<br/>Status Completed with a separate final outcome"]
        CREATED -->|Best-effort started event| STARTED --> FINISHED
        CREATED -->|Started event lost or arrives too late| FINISHED
        LATE["Late/duplicate started events update only Queued rows<br/>They cannot move a Completed job backwards"]
    end

    subgraph RESULTS["ResultConsumer - one unacked result per business worker"]
        INPUT[["ocr-results delivery"]]
        PARSE{"Result JSON deserializes<br/>to a non-null message?"}
        TX["Begin PostgreSQL transaction<br/>SELECT jobs row FOR UPDATE"]
        FOUND{"Job exists?"}
        COUNT["Increment ResultDeliveries"]
        DUP{"Job already Completed?"}
        DUPCOMMIT["Save delivery count and commit<br/>Do not overwrite fields, outcome or business effects"]

        REJECT{"OCR outcome Rejected<br/>or details report ID conflict/id_mismatch?"}
        REJECTED["Outcome Rejected<br/>Reason FRONT_BACK_ID_MISMATCH"]
        TECH{"OCR outcome TechnicalError?"}
        TECHNICAL["Outcome TechnicalError<br/>Reason OCR_TECHNICAL_ERROR"]
        UNREAD{"OCR outcome Unreadable<br/>or extractedFields is null?"}
        OCRFAILED["Outcome OcrFailed<br/>Reason OCR_UNREADABLE"]
        INVALIDCONF{"Confidence missing, not finite,<br/>below 0 or above 1?"}
        REVIEWMISSING["Outcome ManualReview<br/>Reason OCR_CONFIDENCE_UNAVAILABLE"]
        LOW{"Confidence below configured threshold?<br/>Default threshold 0.75"}
        REVIEWLOW["Outcome ManualReview<br/>Reason LOW_CONFIDENCE"]
        SUCCESS["Outcome Succeeded<br/>Empty reason-code list"]
        POLICY["Current acceptance policy<br/>Passing confidence is sufficient<br/>LowConfidence OCR label, review flags,<br/>field formats or expiry do not independently reject a job<br/>ValidationFailed exists in the enum but is not returned here"]

        SAVE["Store OCR outcome and business outcome separately<br/>Fields and details in JSONB; confidence and reason codes<br/>OCR duration, model version and both worker IDs<br/>Set StartedAt, CompletedAt and Status Completed"]
        COMMIT["Save changes and COMMIT transaction"]
        ACK["ACK result delivery only after commit"]
        DLQ[["NACK without requeue<br/>ocr-results.dlq"]]
        TRANSIENT["Transient processing/DB exception<br/>Rollback uncommitted transaction<br/>Wait 3 seconds; NACK with requeue"]
        SHUTDOWN["Shutdown during processing<br/>Leave delivery unacked; broker redelivers"]
    end

    subgraph JOBDELIVERY["OCR-side delivery safety"]
        JOB[["ocr-jobs delivery"]]
        VALID{"Valid job message?"}
        JOBBAD[["Reject malformed message<br/>ocr-jobs.dlq"]]
        RUN["Prepare images and run OCR<br/>Image/inference failures normally become terminal OCR results"]
        PUB["Publish persistent result<br/>Mandatory routing plus publisher confirmation"]
        CONFIRMED{"Publication confirmed?"}
        JOBACK["ACK original OCR job<br/>Result is queued; business DB commit may still be pending"]
        DISCONNECT["Connection or publication failure<br/>Unacked original job is eligible for redelivery<br/>Old futures never publish on a replacement channel"]
        DUPNOTE["At-least-once delivery<br/>A failure after result publication but before job ACK<br/>can produce duplicate OCR results<br/>Completed-row check makes business result application idempotent"]
    end

    subgraph EVENTS["Informational progress path"]
        EQ[["job-events delivery"]]
        UPDATE["Try guarded DB update<br/>Queued to OcrInProgress<br/>Record workerId and startedAt"]
        EVENTACK["Always ACK<br/>Malformed events or DB-update failures are logged and discarded<br/>No retry or application dead-letter routing on this path"]
        EQ --> UPDATE --> EVENTACK
        UPDATE -.-> STARTED
    end

    INPUT --> PARSE
    PARSE -->|No| DLQ
    PARSE -->|Yes| TX --> FOUND
    FOUND -->|No; permanent unknown job| DLQ
    FOUND -->|Yes| COUNT --> DUP
    DUP -->|Yes| DUPCOMMIT --> ACK
    DUP -->|No| REJECT
    REJECT -->|Yes| REJECTED
    REJECT -->|No| TECH
    TECH -->|Yes| TECHNICAL
    TECH -->|No| UNREAD
    UNREAD -->|Yes| OCRFAILED
    UNREAD -->|No| INVALIDCONF
    INVALIDCONF -->|Yes| REVIEWMISSING
    INVALIDCONF -->|No| LOW
    LOW -->|Yes| REVIEWLOW
    LOW -->|No| SUCCESS
    POLICY -.-> SUCCESS
    REJECTED --> SAVE
    TECHNICAL --> SAVE
    OCRFAILED --> SAVE
    REVIEWMISSING --> SAVE
    REVIEWLOW --> SAVE
    SUCCESS --> SAVE
    SAVE --> COMMIT --> ACK
    COMMIT --> FINISHED
    TX -->|Transient failure anywhere in transaction| TRANSIENT --> INPUT
    TX -->|Cancellation or shutdown| SHUTDOWN --> INPUT
    JOB --> VALID
    VALID -->|No| JOBBAD
    VALID -->|Yes| RUN --> PUB --> CONFIRMED
    PUB --> INPUT
    CONFIRMED -->|Yes| JOBACK
    CONFIRMED -->|No| DISCONNECT --> JOB
    DUPNOTE -.-> DUP
    DUPNOTE -.-> DISCONNECT
    LATE -.-> UPDATE

    classDef success fill:#dcfce7,stroke:#15803d,color:#14532d;
    classDef error fill:#fee2e2,stroke:#dc2626,color:#7f1d1d;
    classDef review fill:#fef3c7,stroke:#d97706,color:#78350f;
    classDef note fill:#f1f5f9,stroke:#64748b,color:#334155;
    class SUCCESS,COMMIT,ACK,JOBACK success;
    class REJECTED,TECHNICAL,OCRFAILED,DLQ,JOBBAD error;
    class REVIEWMISSING,REVIEWLOW,TRANSIENT,DISCONNECT review;
    class POLICY,DUPNOTE,LATE note;
