%% Implemented worker and inference internals. All locking shown is per process.
%% Sources: worker.py, inference.py, pipeline/document.py, pipeline/front_id.py,
%% core/ocr_old/reader.py, core/digits/date_reader.py, fieldmatch/classifier.py.
flowchart TB
    subgraph BOOT["One Python process - startup and shared resources"]
        LAUNCH["Start worker.py<br/>OCR_JOB_CONCURRENCY N: default 1, allowed 1..8<br/>QARI_BATCH_SIZE B: default 1"]
        DEVICE["Resolve cpu, mps, cuda or auto<br/>Validate required offline assets and image API URL"]
        ASSETS[("Offline weights and tokenizer/processor files<br/>Front YOLO; back YOLO; digit CNN<br/>Gender, religion and marital classifiers<br/>Merged Qari / Qwen2-VL model")]
        LOAD["Cache YOLO and classifiers<br/>Preload shared digit CNN<br/>Warm Qari by loading weights and processor<br/>One cached model set for this process"]
        BOOTFAIL["Startup failure<br/>Do not consume jobs"]
        READY["Models ready<br/>Create ThreadPoolExecutor with N job threads"]
        LAUNCH --> DEVICE
        DEVICE -->|Valid| LOAD
        ASSETS --> LOAD
        DEVICE -->|Invalid| BOOTFAIL
        LOAD -->|Load failure| BOOTFAIL
        LOAD -->|Success| READY
    end

    subgraph CONTROL["Main Pika thread - owns connection and channel"]
        CONNECT["Connect to RabbitMQ<br/>Declare durable queues and dead-letter routing<br/>Enable publisher confirms; set prefetch to N<br/>AMQP heartbeat 600 seconds"]
        LOOP["Poll deliveries and completed futures<br/>Inactivity/poll interval about 0.1 second"]
        CAPACITY{"Stop requested or<br/>N jobs already pending?"}
        DRAIN["Stop: accept no more jobs and finish accepted work<br/>Full: service connection events until a slot opens"]
        STOPPED["Close consumer/connection<br/>Shut down thread pool and exit process"]
        RECEIVE["Receive job without automatic ACK"]
        VALIDJOB{"JSON object with valid jobId/correlationId<br/>and a string imageReference?"}
        DLQ[["NACK without requeue<br/>ocr-jobs.dlq"]]
        STARTED["Best-effort publish to job-events<br/>jobId, workerId and startedAt"]
        SUBMIT["Submit run_ocr job as future<br/>Remember original delivery tag and timing<br/>Return immediately to delivery/completion polling"]
        COLLECT["Collect finished future on main thread<br/>Convert unhandled exception to<br/>TechnicalError / INFERENCE_ERROR"]
        PUBLISH["Build OCR result JSON<br/>Persistent message, mandatory route, publisher confirm"]
        RESULTQ[["ocr-results"]]
        CONFIRM{"Broker confirmed result?"}
        ACK["ACK original job tag<br/>Free pending slot"]
        FAIL["Close failed connection; leave unacked deliveries<br/>Cancel queued futures; wait for running calls<br/>Do not reuse stale delivery tags on a new channel"]
        RETRY["Connection retry after 5 seconds<br/>Original unacked jobs may be redelivered"]
    end

    subgraph PREP["Job threads - per-job preparation, allowed to overlap inference"]
        TMP["Create unique TemporaryDirectory<br/>Images, crops and JSON reports stay job-local"]
        SOURCE{"OCR_IMAGE_API_URL configured?"}
        FETCH["Download front then back through fixed API routes<br/>No redirects or system proxy<br/>30-second socket timeout; up to 3 attempts per side<br/>Backoff 1 then 2 seconds<br/>Check content length, streaming 20 MiB limit and nonempty body"]
        LOCAL["Resolve imageReference below OCR_IMAGE_ROOT<br/>Reject escaping paths or missing front/back pair"]
        VERIFY["Pillow verification<br/>JPEG, PNG, WEBP, BMP or TIFF<br/>At most 20 MiB and 25 million pixels<br/>Single frame; reject decompression-bomb conditions"]
        BADIMAGE["Unreadable, confidence 0<br/>INVALID_IMAGE_PAIR<br/>Includes unavailable images on HTTP 404/410"]
        NETERROR["TechnicalError<br/>IMAGE_DOWNLOAD_FAILED<br/>Network failure or API rejection after retry handling"]
        WAIT["Wait for process-wide inference lock<br/>Other job threads can continue preparation<br/>Only one document enters model work"]
    end

    subgraph MODELWORK["One document inside the shared inference gate"]
        ORIENT["Orient images using EXIF and convert to RGB<br/>Create unique front/back output directories"]
        SCHEDULE{"Resolved detector backend is MPS?"}
        MPSSERIAL["Run front/back detection serially<br/>Shared MPS detector lock also protects calls across documents"]
        OTHERPAR["Front/back detector tasks may overlap on CPU/CUDA<br/>Per-detector lock protects each cached YOLO instance"]
        FRONT["Front YOLO - image size 1280<br/>Detect id, name and address"]
        BACK["Back YOLO - image size 800<br/>Detect id, expiredate, gender, job,<br/>spouse field hasband, marital and religion"]
        CROPS["Sort field candidates by detection confidence<br/>Save candidate crops and selected crop paths<br/>Read national ID first on each side using shared digit CNN"]
        IDREAD["Strict 14-digit recognition<br/>Multiple image-threshold variants and confidence evidence<br/>Preserve uncertain or rejected readings"]
        IDGATE{"Initial reconciliation status is agreed?<br/>Both sides independently read exactly the same 14-digit ID"}
        SKIP["Skip Qari, expiry reader and word classifiers<br/>Preserve evidence; mark remaining fields skipped<br/>Report id_mismatch for conflict; otherwise id_unverified"]
        FORK["After ID gate passes, run two independent stage-2 tasks"]

        subgraph TEXT["Text OCR task - shared Qari model"]
            TARGETS["Collect front name/address and back job/spouse crops<br/>One current candidate per unfinished field"]
            BATCH{"B greater than 1 and multiple crops<br/>with merged Qwen2-VL engine?"}
            QBATCH["Hold Qari lock<br/>Prepare at most B independent crop inputs<br/>Left-pad prompts; one greedy generation call for the chunk<br/>Decode each output and count tokens excluding trailing padding"]
            SINGLE["Hold Qari lock<br/>Existing single-crop generation path<br/>Greedy decoding; default max 128 new tokens"]
            BFALLBACK["Batch failure: log warning<br/>Retry the failed chunk's crops individually<br/>Keep errors isolated by crop"]
            RETEXT["Strip added tashkeel from recognized text<br/>Keep first nonempty usable candidate per field"]
            MORE{"Any empty/failed field<br/>has another candidate?"}
            TEXTDONE["Record per-field text, selected crop, tokens,<br/>truncation, timing and review/error evidence"]
        end

        subgraph WORDS["Back-field task - CPU"]
            EXPIRY["Expiry-date recognition with shared digit CNN<br/>Segment digits and slash geometry<br/>Require agreeing valid dates or one very confident valid date<br/>Preserve confidence, attempts and ISO date"]
            CLASSIFY["Classify gender, religion and marital word crops<br/>Use cached CPU models and candidate fallback<br/>Default acceptance threshold 0.9<br/>Retain uncertain labels and scores for review"]
        end

        JOIN["Join text and back-field tasks<br/>Reconcile front/back ID evidence again<br/>Mark document complete or partial and preserve review flags"]
        MAP["Map report to service fields<br/>fullName, nationalId, address, expiryDate,<br/>gender, occupation, spouseName, maritalStatus, religion<br/>Retain front.id and back.id evidence<br/>Derive birthDate from valid nationalId"]
        SCORE["Heuristic confidence, not calibrated accuracy<br/>Per required field: minimum of usable recognition/detection scores<br/>Missing/unusable field scores 0; optional spouse counted if present<br/>Mean field score; unverified ID or stopped pipeline gates score to 0"]
        OUTCOME["Map OCR outcome<br/>No fields: Unreadable<br/>ID conflict: Rejected<br/>Review/partial evidence: LowConfidence<br/>Otherwise Success"]
        RELEASE["Release document-inference lock<br/>Remove job-local temporary files on return or exception"]
    end

    READY --> CONNECT --> LOOP --> CAPACITY
    CAPACITY -->|Stop or full| DRAIN
    DRAIN -->|When running and capacity available| LOOP
    DRAIN -->|Stop and all accepted jobs finished| STOPPED
    CAPACITY -->|Running and capacity available| RECEIVE --> VALIDJOB
    VALIDJOB -->|No| DLQ
    VALIDJOB -->|Yes| STARTED --> SUBMIT
    SUBMIT --> LOOP
    SUBMIT --> TMP --> SOURCE
    SOURCE -->|Yes| FETCH --> VERIFY
    SOURCE -->|No| LOCAL --> VERIFY
    FETCH -->|Missing or invalid response body| BADIMAGE
    FETCH -->|Exhausted download failure| NETERROR
    LOCAL -->|Invalid reference or missing images| BADIMAGE
    VERIFY -->|Invalid| BADIMAGE
    VERIFY -->|Valid| WAIT --> ORIENT --> SCHEDULE
    SCHEDULE -->|Yes| MPSSERIAL
    SCHEDULE -->|No| OTHERPAR
    MPSSERIAL --> FRONT
    MPSSERIAL --> BACK
    OTHERPAR --> FRONT
    OTHERPAR --> BACK
    FRONT --> CROPS
    BACK --> CROPS
    CROPS --> IDREAD --> IDGATE
    IDGATE -->|No| SKIP --> MAP
    IDGATE -->|Yes| FORK
    FORK --> TARGETS --> BATCH
    BATCH -->|Yes| QBATCH
    BATCH -->|No| SINGLE
    QBATCH -->|Failure| BFALLBACK --> SINGLE
    QBATCH -->|Success| RETEXT
    SINGLE --> RETEXT --> MORE
    MORE -->|Yes| TARGETS
    MORE -->|No| TEXTDONE --> JOIN
    FORK --> EXPIRY --> CLASSIFY --> JOIN
    JOIN --> MAP --> SCORE --> OUTCOME --> RELEASE --> COLLECT
    BADIMAGE -->|Temporary directory cleaned| COLLECT
    NETERROR -->|Temporary directory cleaned| COLLECT
    MODELWORK -->|Unhandled exception; locks and temporary files released| COLLECT
    COLLECT --> PUBLISH --> RESULTQ
    PUBLISH --> CONFIRM
    CONFIRM -->|Yes| ACK --> LOOP
    CONFIRM -->|No| FAIL --> RETRY --> CONNECT
    CONNECT -->|AMQP or socket failure| RETRY

    classDef error fill:#fee2e2,stroke:#dc2626,color:#7f1d1d;
    classDef lock fill:#fef3c7,stroke:#d97706,color:#78350f;
    classDef model fill:#e0f2fe,stroke:#0284c7,color:#0c4a6e;
    classDef queue fill:#ede9fe,stroke:#7c3aed,color:#4c1d95;
    class BOOTFAIL,DLQ,BADIMAGE,NETERROR,FAIL,BFALLBACK error;
    class WAIT,MPSSERIAL,OTHERPAR lock;
    class FRONT,BACK,IDREAD,QBATCH,SINGLE,EXPIRY,CLASSIFY model;
    class RESULTQ queue;
