# Copy to .env on the receiving machine; never share the real credentials.
ORACLE_DSN=DB_HOST:1521/SERVICE_NAME
ORACLE_USER=BRK_COD
ORACLE_PASSWORD=
# Windows only: actual folder containing the compatible 64-bit Oracle 19c client.
# On Linux leave empty and configure the Oracle Client library search path.
ORACLE_CLIENT_LIB_DIR=
OCR_DEVICE=cpu
# Use cuda on the Linux NVIDIA worker after verifying CUDA-enabled PyTorch.
# Optional output override; defaults to try1/outputs/oracle_workers.
# ORACLE_OUTPUT_ROOT=/path/to/ocr-output

# Async Spark API only. Use a strong service token; never commit the real value.
OCR_API_TOKEN=
# Oracle HTTP coordinator: local SSH forwarding can expose Spark at this URL.
OCR_API_URL=http://127.0.0.1:18001
